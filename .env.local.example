# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, never expose to the browser
# Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Used by /api/parse-resume to extract structured data from CV PDFs
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (claude-sonnet-4-6 is recommended)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Resend (email alerts) ─────────────────────────────────────────────────────
# Get your key at https://resend.com — leave blank to skip email sending in dev
RESEND_API_KEY=re_...

# Must be a domain you have verified in Resend
RESEND_FROM=alerts@helpinghandsgcc.com

# ── Site URL ──────────────────────────────────────────────────────────────────
# Used in sitemap.xml, email links, and server-side redirects
NEXT_PUBLIC_SITE_URL=https://helpinghandsgcc.com

# ── Security ──────────────────────────────────────────────────────────────────
# Random secret — Vercel includes this in the Authorization header on cron calls
# Generate with: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# Optional separate secret for /api/ingest-jobs. Falls back to CRON_SECRET if omitted.
INGEST_SECRET=generate-with-openssl-rand-hex-32

# Password for /admin — used by the login page and middleware cookie check
ADMIN_SECRET=choose-a-strong-password
